@model IEnumerable<Nvm_Lesson07.Models.DataModels.Member>;
@{
	ViewData["Title"] = "Danh sách member";
}
<div class="list list-group">
	<div class="list list-group-item" style="display: inline-flex">
		<h1 style="flex: 1">@ViewData["Title"]</h1>
		<a asp-action="Add" class="btn btn-primary my-1" style="text-decoration: none, flex: 1">Add</a>
	</div>
	<table class="table table-bordered table-striped">
		<thead>
			<th>@Html.DisplayNameFor(Model => Model.id)</th>
			<th>@Html.DisplayNameFor(Model => Model.name)</th>
			<th>@Html.DisplayNameFor(Model => Model.fullname)</th>
			<th>@Html.DisplayNameFor(Model => Model.password)</th>
		</thead>
		<tbody>
			@if (Model != null)
			{
				@foreach (var item in Model)
				{
					<tr>
						<td>@Html.DisplayFor(Modelitem => item.id)</td>
						<td>@Html.DisplayFor(Modelitem => item.name)</td>
						<td>@Html.DisplayFor(Modelitem => item.fullname)</td>
						<td>@Html.DisplayFor(Modelitem => item.password)</td>
						<td>
							@Html.ActionLink("Edit", "Edit", new { }) |
							@Html.ActionLink("Detail", "Detail", new { }) |
							@Html.ActionLink("Delete", "Delete", new { }) |
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>