@{
	ViewData["Title"] = "Thông tin sản phẩm";
	NvmProduct product = ViewData["dataproduct"] as Nvm_Lesson02__Theory.Models.NvmProduct;
}

<h1>@ViewData["Title"]</h1>
<div class="alert alert-danger">
	<h2>Dữ liệu sản phầm</h2>
	<p>ID: @product.ProductId</p><br />
	<p>Name: @product.ProductName</p><br />
