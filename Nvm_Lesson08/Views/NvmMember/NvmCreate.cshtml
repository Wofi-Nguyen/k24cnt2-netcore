@model Nvm_Lesson08.Models.NvmMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}
<form asp-action="NvmCreate" method="post">
<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="NvmMemberId" class="control-label"></label>
                    <input asp-for="NvmMemberId" class="form-control" />
                    <span asp-validation-for="NvmMemberId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NvmUserName" class="control-label"></label>
                    <input asp-for="NvmUserName" class="form-control" />
                    <span asp-validation-for="NvmUserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NvmPassword" class="control-label"></label>
                    <input asp-for="NvmPassword" class="form-control" />
                    <span asp-validation-for="NvmPassword" class="text-danger"></span>
                </div>
               
            </div>
        </div>
    </div>

    <div class="card-footer">
        <div class="form-group">
            <input type="submit" value="Ghi lại" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>
</form>